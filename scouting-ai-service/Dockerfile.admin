FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY adminplatform ./adminplatform
RUN mkdir -p /app/data/chatbot_uploads

EXPOSE 8000

CMD ["uvicorn", "adminplatform.main:app", "--host", "0.0.0.0", "--port", "8000"]
